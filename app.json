{
  "expo": {
    "name": "ניהול הבית",
    "slug": "home-management",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "automatic",
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.homemgmt.app",
      "infoPlist": {
        "LSApplicationQueriesSchemes": [
          "whatsapp"
        ],
        "NSPhotoLibraryUsageDescription": "לבחירת תמונה לדיווח תקלה",
        "NSCameraUsageDescription": "לצילום תמונה לדיווח תקלה"
      }
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#E6F4FE",
        "foregroundImage": "./assets/android-icon-foreground.png",
        "backgroundImage": "./assets/android-icon-background.png",
        "monochromeImage": "./assets/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false,
      "package": "com.homemgmt.app"
    },
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "scheme": "homemgmt",
    "plugins": [
      "expo-router",
      "expo-image-picker",
      "expo-updates",
      [
        "expo-notifications",
        {
          "color": "#4F46E5"
        }
      ]
    ],
    "extra": {},
    "runtimeVersion": {
      "policy": "appVersion"
    }
  }
}